            "name": "Calculate Negotiations Count",
            "returnType": "object",
            "sourceCode": "const buckets =  $context.$nodes.GET_NEGOTIATIONS_COUNT.$output.aggregations.orderForCurrentNegotiationStatusCode.buckets;\n\nlet active= 0;\nlet draft = 0;\nlet openingSoon = 0;\nlet pendingAward = 0;\n\n\nfor (const bucket of buckets) {\n   if(bucket.key==\"ACTIVE\"){\n      active = active+bucket.doc_count;\n   }else if(bucket.key==\"SUBMITTED\" || bucket.key==\"PREVIEW\"){\n      openingSoon  = openingSoon +bucket.doc_count;\n   }else if(bucket.key==\"DRAFT\" || bucket.key==\"REJECTED\" || bucket.key==\"WITHDRAWN\" || bucket.key==\"APPROVAL_IN_PROCESS\"){\n       draft  = draft +bucket.doc_count;\n   }else if(bucket.key==\"CLOSED\" || bucket.key==\"AWARD_APPROVAL_INPROCESS\" || bucket.key==\"AWARD_IN_PROG\" || bucket.key==\"AWARD_REJECTED\" || bucket.key==\"AWARD_APPROVED\" || bucket.key==\"AWARD_APPROVAL_WITHDRAWN\"){\n       pendingAward = pendingAward +bucket.doc_count;\n   }\n}\n\nlet statusCountsObj = {\n  items: [\n    { status: \"Active\",  count: active },\n    { status: \"Opening Soon\",  count: openingSoon },\n    { status: \"Draft\",  count: draft },\n    { status: \"Pending Award\", count: pendingAward }\n  ]\n};\n\nreturn statusCountsObj ;"
          },
