          "tools": [
            {
              "bodyTemplate": "{\n    \"aggs\": {\n        \"orderForCurrentNegotiationStatusCode\": {\n            \"terms\": {\n                \"script\": {\n                    \"source\": \"def p_auction_status = doc['AuctionStatus'].value; def p_award_status = (!doc.containsKey('AwardStatus') || doc['AwardStatus'].empty)?'':doc['AwardStatus'].value;def negotiation_status_code = (!doc.containsKey('NegotiationStatusCode') || doc['NegotiationStatusCode'].empty)?'':doc['NegotiationStatusCode'].value;def statusCode = '';if(negotiation_status_code=='SUBMITTED' || negotiation_status_code=='PREVIEW' || negotiation_status_code=='ACTIVE' || negotiation_status_code=='CLOSED' || negotiation_status_code=='AWARD_IN_PROG'){def currentUtcMillis = System.currentTimeMillis();def openDateMillis;if(doc.containsKey('OpenDate') && !doc['OpenDate'].empty){ openDateMillis = doc['OpenDate'].value.toInstant().toEpochMilli(); }def viewByDateMillis;def closeDateMillis;if(doc.containsKey('CloseDate') && !doc['CloseDate'].empty){closeDateMillis = doc['CloseDate'].value.toInstant().toEpochMilli();}if(!doc.containsKey('ViewByDate') || doc['ViewByDate'].empty){viewByDateMillis = openDateMillis;}else{viewByDateMillis = doc['ViewByDate'].value.toInstant().toEpochMilli();}if(viewByDateMillis!=null && viewByDateMillis>currentUtcMillis) statusCode = 'SUBMITTED';else if(openDateMillis!=null && openDateMillis>currentUtcMillis) statusCode = 'PREVIEW';else if(closeDateMillis!=null && closeDateMillis>currentUtcMillis) statusCode = 'ACTIVE';else if(p_auction_status == 'ACTIVE'){if(p_award_status == 'NO'){statusCode = 'CLOSED';}else if(p_award_status == 'PARTIAL' || p_award_status == 'AWARDED'){statusCode = 'AWARD_IN_PROG';}else{statusCode = negotiation_status_code}}}else{statusCode = negotiation_status_code;}\",\n                    \"lang\": \"painless\"\n                },\n                \"size\": \"30\"\n            }\n        }\n    }\n}",
              "description": "Get the count of all negotiations by status.",
